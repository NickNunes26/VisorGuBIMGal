// Icon and version information of VisorGuBIMGal.exe (compiled by build.rs with rc.exe).
// Numeric constants instead of <winver.h>, so rc.exe needs no include path.

1 ICON "icons/icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "VisorGuBIMGal"
      VALUE "FileDescription", "VisorGuBIMGal - Visor BIM/GIS"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "VisorGuBIMGal"
      VALUE "OriginalFilename", "VisorGuBIMGal.exe"
      VALUE "ProductName", "VisorGuBIMGal"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END

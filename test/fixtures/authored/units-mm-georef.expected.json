    "count": "1",
    "ifc_project_length_unit": "mm (IfcSIUnit LENGTHUNIT, Prefix MILLI, Name METRE)",
    "note": "The IFC file stores lengths in millimetres.  Every length, coordinate, bounding box and volume in this file is reported in metres, i.e. the IFC length value divided by 1000."
  },
  "tolerance_note": "Every numeric quantity carries its own tolerance. Expected values are in metres after the IFC millimetre-to-metre conversion.  Volumes and bounding boxes are closed-form products of the design dimensions, exact to 1e-9; the 1e-6 m tolerances allow for viewer float precision.  World coordinates apply IfcMapConversion with Scale = 0.001 and no rotation.",
  "georeference": {
    "projected_crs": "EPSG:25829",
    "eastings": {
      "value": 536500.0,
      "unit": "m",
      "tolerance": 1e-09,
      "note": "IfcMapConversion.Eastings"
    },
    "northings": {
      "value": 4747500.0,
      "unit": "m",
      "tolerance": 1e-09,
      "note": "IfcMapConversion.Northings"
    },
    "orthogonal_height": {
      "value": 260.0,
      "unit": "m",
      "tolerance": 1e-09,
      "note": "IfcMapConversion.OrthogonalHeight"
    },
    "x_axis_abscissa": {
      "value": 1.0,
      "unit": "1",
      "tolerance": 1e-12,
      "note": "map east is local +X (no rotation)"
    },
    "x_axis_ordinate": {
      "value": 0.0,
      "unit": "1",
      "tolerance": 1e-12,
      "note": "map north is local +Y (no rotation)"
    },
    "scale": {
      "value": 0.001,
      "unit": "1",
      "tolerance": 1e-12,
      "note": "IfcMapConversion.Scale: local millimetres to CRS metres"
    },
    "note": "map_easting = 536500 + 0.001 * local_x_mm = 536500 + local_x_m; map_northing = 4747500 + local_y_m; map_height = 260 + local_z_m."
  },
  "computation": {
    "units": "All six boxes were designed in millimetres.  Dividing each IFC length by 1000 gives metres; no other unit conversion is needed because area and volume units are square and cubic metres.",
    "volumes": "Each element is an IfcExtrudedAreaSolid of an IfcRectangleProfileDef, so its volume is exactly x * y * z of the design box.  The four walls sit between the floor and roof slabs and do not overlap each other (west and east walls span only the clear 4.50 m between the south and north walls).",
    "bbox": "Each box has an axis-aligned placement at its centre in plan and at its base in Z, and a rectangle profile centred on that placement.  The bounding box is therefore centre +/- half size in X and Y and base..base+height in Z.",
    "georeference": "IfcMapConversion has no rotation, so each local (x, y, z) in millimetres maps to (536500 + 0.001*x, 4747500 + 0.001*y, 260 + 0.001*z) in metres.  This is the same factor as the millimetre-to-metre unit conversion, on purpose: the fixture checks that Scale is applied to the local coordinates before translation.",
    "extent": "The roof overhangs the walls by 0.20 m on all four sides, so the model extent is x = -0.20..8.20 m, y = -0.20..5.20 m, z = 0.00..3.40 m."
  },
